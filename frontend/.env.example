# Data source mode: live (default) or demo.
# live  — fetches the real backend API; shows "● LIVE" badge in the header.
# demo  — returns clock-driven demo snapshots; shows "DEMO DATA" badge.
VITE_DATA_MODE=live

# Backend base URL (no trailing slash).
VITE_API_BASE=http://127.0.0.1:8000

# Legacy variable kept for reference — superseded by VITE_DATA_MODE.
# VITE_DEMO_MODE=false
