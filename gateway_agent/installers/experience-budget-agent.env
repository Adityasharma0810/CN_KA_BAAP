# /etc/default/experience-budget-agent
# Environment for the Experience Budget gateway agent.
# Secrets must never be committed to version control.

EB_GATEWAY_ID=gw-home-01
EB_HOUSEHOLD_ID=<your-household-id>
EB_CONTROL_PLANE_URL=https://experience-budget.example.com
EB_AGENT_TOKEN=<agent-token-from-control-plane>
EB_WAN_INTERFACE=wlan0
EB_LAN_INTERFACE=ap0
EB_AP_SSID=Experience-Budget
EB_AP_PASSWORD=<wpa2-passphrase>
EB_SAMPLING_INTERVAL_SECONDS=5
EB_ML_CYCLE_SECONDS=30
EB_ENABLE_IP_FORWARDING=true
EB_ENABLE_NAT=true
EB_ENFORCEMENT_MODE=auto
